{
  "mcpServers": {
    "GoogleSheets": {
      "command": "node",
      "args": [
        "/Users/admin/Documents/AIAgent_MCP_Portfolio/google-sheets-mcp/server.mjs"
      ]
    },
    "GoogleForms": {
      "command": "node",
      "args": [
        "/Users/admin/Documents/AIAgent_MCP_Portfolio/google-forms-mcp/server.mjs"
      ]
    },
    "Playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "Firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": ""
      }
    },
    "Slack": {
      "url": "https://mcp.slack.com/mcp"
    },
    "Notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "Figma": {
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
